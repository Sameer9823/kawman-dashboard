# ── Database (Neon Postgres) ──────────────────────────────────────────────
# Create a free project at https://neon.tech, then copy the pooled
# connection string it gives you (it will look like the example below).
# Neon's pooled connection is what your app should use at runtime.
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"

# Neon also gives you a *direct* (non-pooled) connection string — use that
# one for DIRECT_URL. Prisma's CLI (migrate, db push, prisma.config.ts) uses
# this one directly, since migrations can't run through the pooler.
DIRECT_URL="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require"

# ── Auth (better-auth) ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="replace-with-a-random-64-char-hex-string"
# The public URL of your deployed app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Optional integrations (leave blank to disable the related feature) ────
# AI insights / chat (either works — code checks OPENAI first)
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# File uploads (Cloudinary) — required for the Files module
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Maps / geolocation (field sales module)
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Background jobs (BullMQ) — only needed once the jobs module is wired up
REDIS_URL=""

# Transactional email (Resend) — password reset + user invite emails.
# Leave blank to fall back to logging emails to the server console (dev).
RESEND_API_KEY=""
EMAIL_FROM=""
